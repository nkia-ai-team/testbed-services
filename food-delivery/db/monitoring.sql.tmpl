-- DPM 모니터링 계정 (lucida-next collector-dpm 전용, 읽기 전용)
--
-- 왜 시드에 있는가: 이 계정은 2026-07-13 등록 이래 손으로 만들어져 있었다.
-- 같은 구성이던 banking Oracle 은 2026-07-28 tb-w2 로 옮기며 PV 가 새로 생기자
-- 계정이 사라져 DPM 이 36시간 넘게 멈췄다. food MySQL 이 무사했던 이유는
-- 능력이 아니라 볼륨 나이(PVC 07-13 생성분)뿐이었다 — 이사 한 번이면 같은 일이
-- 난다. 그래서 예약된 사고를 시드로 막는다.
--
-- 자격증명 정본은 k8s/01-secrets.yaml 하나다. build-and-deploy.sh Phase 2.5 가
-- 거기서 읽어 아래 자리표시자를 치환한 뒤 ConfigMap 으로 넣는다. 이 파일에는
-- 값을 적지 않는다(중복 정의가 곧 다음 번 불일치다).
--
-- 실행 컨텍스트: /docker-entrypoint-initdb.d 의 스크립트는 root 로 돈다.
-- 파일명이 00- 이라 01-init.sql 보다 먼저 실행된다.
CREATE USER '__MON_USER__'@'%' IDENTIFIED BY '__MON_PASSWORD__';

-- 2026-07-29 가동 중인 인스턴스의 실제 권한을 그대로 옮긴 것이다(추정 아님).
-- 마지막 fooddelivery 조회권이 없으면 접속은 되고 수집만 Error 1044 로 실패한다.
GRANT PROCESS, REPLICATION CLIENT ON *.* TO '__MON_USER__'@'%';
GRANT SELECT ON `performance_schema`.* TO '__MON_USER__'@'%';
GRANT SELECT, EXECUTE ON `sys`.* TO '__MON_USER__'@'%';
GRANT SELECT ON `fooddelivery`.* TO '__MON_USER__'@'%';
