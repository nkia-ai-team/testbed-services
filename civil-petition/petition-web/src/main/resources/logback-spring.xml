<?xml version="1.0" encoding="UTF-8"?>
<!-- 앱 로그는 파일 하나(날짜별 회전, 30일)로만 쓴다. 콘솔(catalina.out, journal)에는 쓰지 않는다. -->
<configuration>
    <property name="LOG_DIR" value="${petition.log.dir:-/var/log/tomcat10}"/>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/petition.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/petition.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
