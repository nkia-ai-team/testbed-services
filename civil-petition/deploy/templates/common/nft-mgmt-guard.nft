# 관리 NIC 로는 하이퍼바이저 관리 주소의 ssh 와 이미 맺은 연결의 응답만 받는다(설계 §3-5 규칙 4).
# 관리 NIC 에는 기본 경로가 없고 연결된 대역 하나만 있다(netplan).
# 관리 SSH(하이퍼바이저 관리 주소와 이 장비 22번 사이)는 conntrack 에서 뺀다(notrack). conntrack 표가 가득 차는 장애 동안에도
# 러너의 정리 SSH 가 붙게 하기 위해서다(실제 장비도 관리면을 전달면 세션 표와 따로 처리한다).
# 빠진 흐름은 ct state 가 untracked 라 아래 input 의 "관리 주소 22번 accept" 줄로 받는다.
table inet mgmtguard {
	chain prerouting {
		type filter hook prerouting priority -300; policy accept;
		iifname "{{mgmt_if}}" ip saddr {{mgmt_host}} ip daddr {{mgmt_addr}} tcp dport 22 notrack
	}
	chain output {
		type filter hook output priority -300; policy accept;
		oifname "{{mgmt_if}}" ip saddr {{mgmt_addr}} ip daddr {{mgmt_host}} tcp sport 22 notrack
	}
	chain input {
		type filter hook input priority -10; policy accept;
		iifname "{{mgmt_if}}" ct state established,related accept
		iifname "{{mgmt_if}}" ip saddr {{mgmt_host}} tcp dport 22 accept
{{operator_ssh_accept}}
		iifname "{{mgmt_if}}" drop
	}
}
