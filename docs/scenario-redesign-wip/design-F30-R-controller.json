    "observations": [
      {
        "id": "entry_status",
        "adapter": "http_probe",
        "query_id": "http.entry_health",
        "freshness": "15s"
      },
      {
        "id": "target_health",
        "adapter": "http_probe",
        "query_id": "http.target_health",
        "freshness": "15s"
      },
      {
        "id": "pod_ready",
        "adapter": "kubernetes",
        "query_id": "kubernetes.pod_ready",
        "parameters": {
          "namespace": "rca-testbed-food",
          "resource": "testbed-payment"
        },
        "freshness": "30s"
      },
      {
        "id": "order_create_2xx_rate",
        "adapter": "loadgen_summary",
        "query_id": "loadgen.transfer_2xx_rate",
        "freshness": "30s"
      },
      {
        "id": "order_create_429_rate",
        "adapter": "loadgen_summary",
        "query_id": "loadgen.food_create_429_rate",
        "freshness": "30s"
      },
      {
        "id": "read_step_rate",
        "adapter": "loadgen_summary",
        "query_id": "loadgen.read_step_status_rate",
        "freshness": "30s"
      },
      {
        "id": "payment_error_rate",
        "adapter": "clickhouse",
        "query_id": "clickhouse.service_error_rate",
        "parameters": {
          "service_name": "food-delivery-payment"
        },
        "freshness": "60s"
      },
      {
        "id": "achieved_rps",
        "adapter": "loadgen_summary",
        "query_id": "loadgen.achieved_rps",
        "freshness": "30s"
      },
      {
        "id": "order_create_2xx_rate_baseline",
        "adapter": "loadgen_summary",
        "query_id": "loadgen.transfer_2xx_rate",
        "parameters": {
          "domain": "food-delivery"
        },
        "freshness": "30s"
      }
    ],
    "success": {
      "all": [
        {
          "id": "order-create-collapsed",
          "observation": "order_create_2xx_rate",
          "op": "lt",
          "value": 0.2
        }
      ],
      "consecutive_ticks": 3
    },
    "escalate": {
      "any": [
        {
          "id": "contract-break-not-visible",
          "observation": "order_create_2xx_rate",
          "op": "gte",
          "value": 0.5
        }
      ],
      "consecutive_ticks": 3
    },
    "must_rule_out": {
      "any": [
        {
          "id": "load-not-delivered",
          "observation": "achieved_rps",
          "op": "lt",
          "value": 1
        },
        {
          "id": "payment-also-erroring",
          "observation": "payment_error_rate",
          "op": "gte",
          "value": 5
        },
        {
          "id": "pg-rate-limited",
          "observation": "order_create_429_rate",
          "op": "gte",
          "value": 0.1
        },
        {
          "id": "read-path-also-broken",
          "observation": "read_step_rate",
          "op": "gte",
          "value": 0.1
        },
        {
          "id": "payment-pod-down",
          "observation": "pod_ready",
          "op": "eq",
          "value": false
        }
      ],
      "consecutive_ticks": 2
    },
    "abort": {
      "any": [
        {
          "id": "entry-unreachable",
          "observation": "entry_status",
          "op": "eq",
          "value": 0
        }
      ],
      "consecutive_ticks": 2
    },
    "recovery": {
      "all": [
        {
          "id": "target-recovered",
          "observation": "target_health",
          "op": "eq",
          "value": 200
        },
        {
          "id": "pod-recovered",
          "observation": "pod_ready",
          "op": "eq",
          "value": true
        },
        {
          "id": "create-recovered",
          "observation": "order_create_2xx_rate_baseline",
          "op": "gte",
          "value": 0.7
        }
      ],
      "consecutive_ticks": 2,
      "timeout": "10m"
    },
    "cleanup": {
      "required": true,
      "order": "reverse",
      "timeout": "10m"
    },
    "capture": {
      "enabled": true,
      "pre_window": "10m",
      "post_window": "20m",
      "model_snapshot": "/var/lib/lucida/ai-models/stream-anomaly/global/v1/model.json",
      "create_golden_anomaly": false
    }
  }
}
