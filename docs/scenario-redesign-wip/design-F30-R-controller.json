{
  "_note": "F30-R 승격용 controller 초안. compile-plan.py:150-152 가 controller 를 readiness=ready 시나리오에만 허용하므로 draft 동안은 registry/controllers.json 에 넣지 않는다(F24-Q 와 같은 방식). 첫 시험 실행(calibration)을 위해 승격할 때 이 블록을 controllers.json 의 controllers 와 live_scenario_ids 끝에 그대로 옮긴다. 레벨 parameters 는 registry/profiles.json k8s.env scenario_levels.F30-R 과 같다.",
  "scenario_id": "F30-R",
  "controller": {
    "dispatcher_mode": "trusted",
    "live_enabled": true,
    "mode": "calibration",
    "tick_interval": "15s",
    "settle_after_change": "30s",
    "max_injection_duration": "25m",
    "preflight": [
      "kube-context",
      "kube-node-set",
      "coordinator-clean",
      "clean-window",
      "baseline-traffic",
      "baseline-business-success",
      "target-health"
    ],
    "baseline": {
      "clean_window": "30m",
      "required": [
        {
          "check": "coordinator-clean"
        },
        {
          "check": "clean-window"
        },
        {
          "check": "baseline-traffic"
        },
        {
          "check": "baseline-business-success"
        },
        {
          "check": "target-health"
        }
      ]
