# Every 10 minutes at fixed minutes from normal operation on, recording or not: no randomized delay,
# so its own small load is part of every baseline and never lines up with an injection.
[Unit]
Description=Testbed health line every 10 minutes

[Timer]
OnCalendar=*-*-* *:03/10:00
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
