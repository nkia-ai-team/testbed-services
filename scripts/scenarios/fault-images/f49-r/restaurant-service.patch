+    @Transactional(readOnly = true)
+    public RestaurantDetailResponse getRestaurantDetail(Long id) {
+        Restaurant r = restaurantRepository.findById(id)
+                .orElseThrow(() -> new ServiceException(HttpStatus.NOT_FOUND, "Restaurant not found: " + id));
+        return new RestaurantDetailResponse(r.getId(), r.getName(), r.getRegion(),
+                new RestaurantDetailResponse.Status(r.getStatus(), statusLabel(r.getStatus())));
+    }
+
+    private static String statusLabel(String status) {
+        if ("OPEN".equalsIgnoreCase(status)) {
+            return "영업 중";
+        }
+        if ("CLOSED".equalsIgnoreCase(status)) {
+            return "영업 종료";
+        }
+        return status;
+    }
