+package com.fooddelivery.dispatch.config;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.mock.web.MockFilterChain;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class ClientRateLimitFilterTest {
+
+    private final AtomicLong now = new AtomicLong(1_000_000_000L);
+    private final ClientRateLimitFilter filter = new ClientRateLimitFilter(now::get);
+
+    private int call(String client, String path) throws Exception {
+        MockHttpServletRequest request = new MockHttpServletRequest("GET", path);
+        request.setRemoteAddr(client);
+        MockHttpServletResponse response = new MockHttpServletResponse();
+        filter.doFilter(request, response, new MockFilterChain());
+        return response.getStatus();
+    }
+
+    @Test
+    void pollingClientIsLimitedAfterBurst() throws Exception {
+        for (int i = 0; i < ClientRateLimitFilter.BURST; i++) {
+            assertThat(call("203.0.113.10", "/api/deliveries/7")).isEqualTo(200);
+        }
+        assertThat(call("203.0.113.10", "/api/deliveries/7")).isEqualTo(429);
+    }
+
+    @Test
+    void otherClientsKeepTheirOwnLimit() throws Exception {
+        for (int i = 0; i < ClientRateLimitFilter.BURST + 5; i++) {
+            call("203.0.113.10", "/api/deliveries/7");
+        }
+        assertThat(call("203.0.113.11", "/api/deliveries/8")).isEqualTo(200);
+        assertThat(call("198.51.100.20", "/api/deliveries")).isEqualTo(200);
+    }
+
+    @Test
+    void tokenIsRefilledEveryThreeSeconds() throws Exception {
+        for (int i = 0; i < ClientRateLimitFilter.BURST; i++) {
+            call("203.0.113.10", "/api/deliveries/7");
+        }
+        assertThat(call("203.0.113.10", "/api/deliveries/7")).isEqualTo(429);
+        now.addAndGet(TimeUnit.SECONDS.toNanos(ClientRateLimitFilter.REFILL_SECONDS));
+        assertThat(call("203.0.113.10", "/api/deliveries/7")).isEqualTo(200);
+        assertThat(call("203.0.113.10", "/api/deliveries/7")).isEqualTo(429);
+    }
+
+    @Test
+    void probesAreNotLimited() throws Exception {
+        for (int i = 0; i < ClientRateLimitFilter.BURST + 5; i++) {
+            assertThat(call("203.0.113.10", "/actuator/health")).isEqualTo(200);
+        }
+    }
+}
