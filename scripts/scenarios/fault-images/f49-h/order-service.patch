+package com.fooddelivery.order.config;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fooddelivery.common.dto.OrderResponse;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.converter.json.Jackson2ObjectMapperBuilder;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** 주문 응답의 시각이 앱 화면 표준으로 나가고, 같은 표기로 다시 읽힌다. */
+class JacksonTimeConfigTest {
+
+    private ObjectMapper mapper() {
+        Jackson2ObjectMapperBuilder builder = Jackson2ObjectMapperBuilder.json();
+        new JacksonTimeConfig().apiDateTimeFormat().customize(builder);
+        return builder.build();
+    }
+
+    @Test
+    void orderCreatedAtUsesAppDateTimeFormat() throws Exception {
+        ObjectMapper mapper = mapper();
+        OrderResponse order = new OrderResponse(7L, "cust-7", 3L, new BigDecimal("15000"), "PENDING",
+                LocalDateTime.of(2026, 10, 9, 12, 30, 0));
+
+        String json = mapper.writeValueAsString(order);
+
+        assertTrue(json.contains("\"createdAt\":\"2026-10-09 12:30:00\""), json);
+        assertEquals(order, mapper.readValue(json, OrderResponse.class));
+    }
+}
