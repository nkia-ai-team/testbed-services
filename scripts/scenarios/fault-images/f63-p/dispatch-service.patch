+
+    private <T> T withinDeadline(String operation, Callable<T> call) {
+        ExecutorService executor = Executors.newFixedThreadPool(1);
+        Future<T> future = executor.submit(call);
+        try {
+            return future.get(LOOKUP_DEADLINE_MS, TimeUnit.MILLISECONDS);
+        } catch (TimeoutException ex) {
+            future.cancel(true);
+            log.warn("{} did not finish within {}ms", operation, LOOKUP_DEADLINE_MS);
+            throw new ServiceException(HttpStatus.GATEWAY_TIMEOUT, operation + " timed out");
+        } catch (ExecutionException ex) {
+            if (ex.getCause() instanceof RuntimeException re) {
+                throw re;
+            }
+            throw new ServiceException(HttpStatus.INTERNAL_SERVER_ERROR, operation + " failed: " + ex.getCause());
+        } catch (InterruptedException ex) {
+            Thread.currentThread().interrupt();
+            throw new ServiceException(HttpStatus.SERVICE_UNAVAILABLE, operation + " interrupted");
+        }
+    }
