@@ -0,0 +1,71 @@
+package com.corebanking.api.service;
+
+import com.corebanking.api.client.AccountClient;
+import com.corebanking.common.dto.AccountResponse;
+import com.corebanking.common.exception.ServiceException;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Component;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+
+/**
+ * 이체 접수 전에 출금, 입금 계좌가 모두 ACTIVE 인지 활성 계좌 목록으로 확인한다.
+ * 목록은 account-service 의 계좌 목록 API(status=ACTIVE)를 페이지 단위로 끝까지 읽어 만들고,
+ * 응답을 늦추지 않도록 이체를 접수할 때마다 뒤에서 새로 고친다.
+ */
+@Component
+public class AccountDirectory {
+
+    private static final Logger log = LoggerFactory.getLogger(AccountDirectory.class);
+    private static final int PAGE_SIZE = 20;
+
+    private final AccountClient accountClient;
+    private volatile Set<String> activeAccounts = Set.of();
+
+    public AccountDirectory(AccountClient accountClient) {
+        this.accountClient = accountClient;
+    }
+
+    public void requireActive(String fromAccount, String toAccount) {
+        Set<String> active = activeAccounts;
+        if (active.isEmpty()) {
+            active = load();
+            activeAccounts = active;
+        }
+        CompletableFuture.runAsync(this::refresh);
+
+        if (!active.contains(fromAccount)) {
+            throw new ServiceException(HttpStatus.BAD_REQUEST, "From account is not active: " + fromAccount);
+        }
+        if (!active.contains(toAccount)) {
+            throw new ServiceException(HttpStatus.BAD_REQUEST, "To account is not active: " + toAccount);
+        }
+    }
+
+    private void refresh() {
+        try {
+            activeAccounts = load();
+        } catch (Exception ex) {
+            log.warn("Active account directory refresh failed: {}", ex.getMessage());
+        }
+    }
+
+    private Set<String> load() {
+        Set<String> active = new HashSet<>();
+        int page = 0;
+        List<AccountResponse> chunk;
+        do {
+            chunk = accountClient.listAccounts("ACTIVE", page++, PAGE_SIZE);
+            for (AccountResponse account : chunk) {
+                active.add(account.id());
+            }
+        } while (chunk.size() == PAGE_SIZE);
+        log.info("Loaded active account directory: pages={} accounts={}", page, active.size());
+        return active;
+    }
+}
