+package com.corebanking.account.service;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.jdbc.datasource.DataSourceUtils;
+import org.springframework.stereotype.Component;
+
+import javax.sql.DataSource;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Timestamp;
+import java.time.LocalDateTime;
+import java.util.Optional;
+
+/**
+ * 잔액 화면의 '마지막 이체일' 표시용. 계좌에서 나간 이체 중 가장 최근 시각을 돌려준다.
+ * 공용 응답(AccountResponse)은 다른 서비스와 함께 쓰므로 바꾸지 않고 응답 헤더로 낸다.
+ * 한 번 묻고 끝나는 가벼운 조회라 JPA 를 거치지 않고, 계좌 조회 트랜잭션의 연결을 그대로 쓴다(DataSourceUtils).
+ */
+@Component
+public class LastTransferLookup {
+
+    private static final Logger log = LoggerFactory.getLogger(LastTransferLookup.class);
+    private static final String LAST_OUTGOING_SQL =
+            "SELECT MAX(created_at) FROM transfers WHERE from_account = ?";
+
+    private final DataSource dataSource;
+
+    public LastTransferLookup(DataSource dataSource) {
+        this.dataSource = dataSource;
+    }
+
+    public Optional<LocalDateTime> lastOutgoingTransferAt(String accountId) {
+        try {
+            Connection conn = DataSourceUtils.getConnection(dataSource);
+            try (PreparedStatement ps = conn.prepareStatement(LAST_OUTGOING_SQL)) {
+                ps.setString(1, accountId);
+                try (ResultSet rs = ps.executeQuery()) {
+                    Timestamp last = rs.next() ? rs.getTimestamp(1) : null;
+                    return Optional.ofNullable(last).map(Timestamp::toLocalDateTime);
+                }
+            }
+        } catch (SQLException | RuntimeException ex) {
+            log.warn("Last transfer lookup failed for account {}: {}", accountId, ex.getMessage());
+            return Optional.empty();
+        }
+    }
+}
