+    public void rejectDuplicateAssignment(Long orderId) {
+        if (orderId == null) {
+            return;
+        }
+        try {
+            Connection conn = dataSource.getConnection();
+            PreparedStatement ps = conn.prepareStatement(
+                    "SELECT count(*) FROM dispatches WHERE order_id = ? AND status = 'ASSIGNED'");
+            ps.setLong(1, orderId);
+            ResultSet rs = ps.executeQuery();
+            long assigned = rs.next() ? rs.getLong(1) : 0;
+            rs.close();
+            ps.close();
+            if (assigned > 0) {
+                conn.close();
+                throw new ServiceException(HttpStatus.CONFLICT,
+                        "Courier already assigned for order " + orderId);
+            }
+        } catch (SQLException ex) {
+            throw new IllegalStateException("Failed to check existing assignment: " + ex.getMessage(), ex);
+        }
+    }
