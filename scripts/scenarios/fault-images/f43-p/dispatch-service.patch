+package com.fooddelivery.dispatch.service;
+
+import com.fooddelivery.common.exception.ServiceException;
+import com.fooddelivery.dispatch.event.DispatchOutboxPublisher;
+import com.fooddelivery.dispatch.repository.DispatchEventLogRepository;
+import com.fooddelivery.dispatch.repository.DispatchRepository;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.HttpStatus;
+
+import javax.sql.DataSource;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/**
+ * order 의 배차 호출이 재시도되어 같은 주문이 두 번 들어오면, 두 번째는 배달원을 새로 잡지 않고 409 다.
+ */
+class DuplicateAssignmentTest {
+
+    @Test
+    void a_second_request_for_an_assigned_order_is_rejected() throws Exception {
+        DataSource dataSource = mock(DataSource.class);
+        Connection conn = mock(Connection.class);
+        PreparedStatement ps = mock(PreparedStatement.class);
+        ResultSet rs = mock(ResultSet.class);
+        when(dataSource.getConnection()).thenReturn(conn);
+        when(conn.prepareStatement(anyString())).thenReturn(ps);
+        when(ps.executeQuery()).thenReturn(rs);
+        when(rs.next()).thenReturn(true);
+        when(rs.getLong(1)).thenReturn(1L);
+        DispatchService service = new DispatchService(mock(DispatchRepository.class),
+                mock(DispatchEventLogRepository.class), mock(DispatchOutboxPublisher.class), dataSource,
+                2000, "food.dispatch");
+
+        ServiceException ex = assertThrows(ServiceException.class, () -> service.rejectDuplicateAssignment(42L));
+
+        assertEquals(HttpStatus.CONFLICT, ex.getStatus());
+        verify(conn).close();
+    }
+}
