+package com.fooddelivery.payment.dto;
+
+import com.fooddelivery.common.dto.PaymentResponse;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+
+/**
+ * 결제 공개 응답(1.3.0). 내부 행 번호를 그대로 내보내지 않고 외부에 보여 줄 결제 키
+ * (pay_ + 8자리 번호)로 내려준다. 고객센터와 정산 화면이 같은 키로 결제를 찾는다.
+ */
+public record PaymentView(
+        String id,
+        Long orderId,
+        String pgProvider,
+        BigDecimal amount,
+        String status,
+        LocalDateTime processedAt
+) {
+    public static PaymentView of(PaymentResponse p) {
+        return new PaymentView(
+                p.id() != null ? String.format("pay_%08d", p.id()) : null,
+                p.orderId(),
+                p.pgProvider(),
+                p.amount(),
+                p.status(),
+                p.processedAt()
+        );
+    }
+}
