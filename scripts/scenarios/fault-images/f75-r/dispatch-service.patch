+package com.fooddelivery.dispatch.controller;
+
+import com.fooddelivery.dispatch.service.DispatchService;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.Map;
+
+/**
+ * 배달원(courier) 자원 API. 가용 배달원 용량은 배차 한 건(delivery)의 속성이 아니라 배달원 풀의
+ * 상태라서 /api/deliveries/capacity 에서 /api/couriers/capacity 로 옮겼다(1.10.0).
+ * 주문 생성 전 용량 확인은 order-service 2.6.0 부터 새 경로를 부른다.
+ */
+@RestController
+@RequestMapping("/api/couriers")
+public class CourierController {
+
+    private final DispatchService dispatchService;
+
+    public CourierController(DispatchService dispatchService) {
+        this.dispatchService = dispatchService;
+    }
+
+    /**
+     * 가용 courier capacity 조회.
+     * 응답: {"currentAssigned": int, "maxCapacity": int, "available": int}
+     */
+    @GetMapping("/capacity")
+    public ResponseEntity<Map<String, Integer>> getCapacity() {
+        return ResponseEntity.ok(dispatchService.getCapacity());
+    }
+}
