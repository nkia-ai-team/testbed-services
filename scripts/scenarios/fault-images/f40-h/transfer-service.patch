@@ -0,0 +1,16 @@
+package com.corebanking.transfer.service;
+
+import java.math.BigDecimal;
+
+/**
+ * 원화 금액 규칙. 원화에는 보조 단위(전)가 없어 이체 금액은 원 단위 정수여야 한다.
+ */
+public final class KrwAmountPolicy {
+
+    private KrwAmountPolicy() {
+    }
+
+    public static boolean isWholeWon(BigDecimal amount) {
+        return amount.scale() <= 0;
+    }
+}
diff --git a/core-banking/transfer-service/src/main/java/com/corebanking/transfer/service/TransferService.java b/core-banking/transfer-service/src/main/java/com/corebanking/transfer/service/TransferService.java
index a4c4d75..8e03fbe 100644
--- a/core-banking/transfer-service/src/main/java/com/corebanking/transfer/service/TransferService.java
+++ b/core-banking/transfer-service/src/main/java/com/corebanking/transfer/service/TransferService.java
@@ -54,6 +54,12 @@ public class TransferService {
         if (request.amount() == null || request.amount().compareTo(BigDecimal.ZERO) <= 0) {
             throw new ServiceException(HttpStatus.BAD_REQUEST, "amount must be positive");
         }
+        // 원화 금액은 원 단위 정수만 받는다(보조 단위 없음).
+        if (!KrwAmountPolicy.isWholeWon(request.amount())) {
+            log.info("Transfer rejected (amount not in whole won): from={} to={} amount={}",
+                    request.fromAccount(), request.toAccount(), request.amount());
+            throw new ServiceException(HttpStatus.BAD_REQUEST, "amount must be in whole won: " + request.amount());
+        }
         if (request.fromAccount().equals(request.toAccount())) {
             throw new ServiceException(HttpStatus.BAD_REQUEST, "fromAccount and toAccount must differ");
         }
