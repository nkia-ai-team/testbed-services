@@ -0,0 +1,26 @@
+package com.corebanking.account.dto;
+
+/**
+ * 이체 접수 공개 응답(1.6.0). 앱 화면이 처리 결과를 그대로 보여 줄 수 있게
+ * 상태를 코드와 표시 이름으로 나눠 내려준다.
+ */
+public record TransferReceiptResponse(
+        String transferId,
+        Status status
+) {
+    public record Status(String code, String label) {}
+
+    public static TransferReceiptResponse of(String transferId, String code) {
+        return new TransferReceiptResponse(transferId, new Status(code, label(code)));
+    }
+
+    private static String label(String code) {
+        if ("COMPLETED".equalsIgnoreCase(code)) {
+            return "이체 완료";
+        }
+        if ("FAILED".equalsIgnoreCase(code)) {
+            return "이체 실패";
+        }
+        return code;
+    }
+}
